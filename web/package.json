{
  "name": "actalog-web",
  "version": "1.3.2",
  "description": "ActaLog - CrossFit Workout Tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-pwa-icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "1.18.1",
    "chart.js": "^4.4.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.2",
    "marked": "^18.0.5",
    "pinia": "^3.0.4",
    "vue": "^3.5.33",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^5.0.6",
    "vuetify": "^4.0.6"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.9",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "sharp": "^0.35.2",
    "vite": "^8.0.11",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.0.16",
    "workbox-window": "^7.3.0"

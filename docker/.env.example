# ActaLog Docker Environment Configuration
# Copy this file to .env and fill in your values
# See the main .env.example in the project root for all available options

# =============================================================================
# GitHub Container Registry
# =============================================================================
GITHUB_OWNER=yourusername
TAG=latest

# =============================================================================
# Application Configuration
# =============================================================================
APP_ENV=production
APP_URL=http://localhost:8080

# Server port (inside container, map to host port in docker-compose)
SERVER_PORT=8080

# Logging
LOG_LEVEL=info
LOG_FORMAT=text

# =============================================================================
# Database Configuration
# =============================================================================
# SQLite (default, recommended for single-server deployments)
DB_DRIVER=sqlite3
DB_NAME=/app/data/actalog.db

# PostgreSQL (uncomment and configure if using PostgreSQL)
# DB_DRIVER=postgres
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=actalog
# DB_USER=actalog
# DB_PASSWORD=your_secure_password_here
# DB_SCHEMA=public
# DB_SSLMODE=disable

# MySQL/MariaDB (uncomment and configure if using MySQL)
# DB_DRIVER=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=actalog
# DB_USER=actalog
# DB_PASSWORD=your_secure_password_here

# Connection pooling (PostgreSQL and MySQL only)
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=5m

# =============================================================================
# JWT Configuration
# =============================================================================
# IMPORTANT: Change this secret to a random secure value!
# Generate with: openssl rand -base64 32
JWT_SECRET=change_this_to_a_secure_random_string_for_production
JWT_EXPIRATION=24h
JWT_REFRESH_DURATION=720h
JWT_ISSUER=actalog

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8080

# =============================================================================
# Registration & Security
# =============================================================================
# Allow new user registration (set to false for invite-only)
ALLOW_REGISTRATION=true

# Email verification requirement
REQUIRE_EMAIL_VERIFICATION=false

# Security settings
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15m

# =============================================================================
# Email Configuration (Optional - for password reset and verification)
# =============================================================================
EMAIL_ENABLED=false
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=ActaLog
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password

# =============================================================================
# Class Scheduling (Phase 4 Feature)
# =============================================================================
# Enable class scheduling feature
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL=6h
SCHEDULER_DAYS_AHEAD=14
SCHEDULER_RUN_ON_STARTUP=true

# =============================================================================
# OpenTelemetry Configuration (Optional - for observability)
# =============================================================================
OTEL_TRACES_ENABLED=false
OTEL_METRICS_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=actalog

# =============================================================================
# File Uploads
# =============================================================================
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=/app/uploads

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ActaLog Backend Environment Configuration
# ============================================================================
# PURPOSE: Main configuration for the Go backend server
# USAGE:   Copy to .env in the project root for local development
#
# OTHER .env FILES IN THIS PROJECT:
#   - docker/.env.example  -> Docker deployment configuration
#                             Use when running with docker-compose
#   - web/.env.example     -> Frontend (Vue.js) configuration
#                             Only needed if API is on a different domain
#
# This file contains ALL available configuration options with documentation.
# The docker/.env.example contains a subset optimized for container deployment.
# ============================================================================

###############################################################################
# APPLICATION SETTINGS
###############################################################################

# Environment: development, staging, production
# In production, JWT_SECRET must be set
APP_ENV=development

# Application URL (used for password reset links in emails)
# In development, this should match where you access the frontend
APP_URL=http://localhost:3000

# Application name (shown in emails, UI)
# APP_NAME=ActaLog

###############################################################################
# LOGGING CONFIGURATION
###############################################################################

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: text (default, human-readable) or json (structured, for log aggregation)
LOG_FORMAT=text

# Enable file logging (logs to ./logs/actalog.log by default)
# Recommended: false for development (use stdout), true for production if not using log aggregation
LOG_FILE_ENABLED=false

# Path to log file (empty = auto-detect: ./logs/actalog.log)
LOG_FILE_PATH=

# Maximum log file size in MB before rotation (default: 100)
LOG_MAX_SIZE_MB=100

# Number of old log files to keep (default: 3)
LOG_MAX_BACKUPS=3

###############################################################################
# SERVER CONFIGURATION
###############################################################################

# Server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Request timeouts (Go duration format: 30s, 1m, 2h)
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=60s
# Note: For benchmark API with large record counts (100k+), increase SERVER_WRITE_TIMEOUT to 120s+

###############################################################################
# DATABASE CONFIGURATION
###############################################################################

# Supported drivers: sqlite3, postgres, mysql
DB_DRIVER=sqlite3

# Database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=actalog
DB_PASSWORD=changeme
DB_NAME=actalog.db

# SSL mode (PostgreSQL only): disable, require, verify-ca, verify-full
DB_SSLMODE=disable

# PostgreSQL schema (default: public)
# Useful for multi-tenant setups or organizing tables
# DB_SCHEMA=actalog

# Connection pooling (PostgreSQL and MySQL only)
# Maximum number of open connections (default: 25)
DB_MAX_OPEN_CONNS=25
# Maximum number of idle connections (default: 5)
DB_MAX_IDLE_CONNS=5
# Maximum connection lifetime (default: 5m)
DB_CONN_MAX_LIFETIME=5m

# --- PostgreSQL Example ---
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=actalog
# DB_PASSWORD=your_secure_password
# DB_NAME=actalog
# DB_SCHEMA=public
# DB_SSLMODE=require

# --- MySQL/MariaDB Example ---
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=actalog
# DB_PASSWORD=your_secure_password
# DB_NAME=actalog
# Note: DB_SSLMODE is not used with MySQL

###############################################################################
# JWT AUTHENTICATION
###############################################################################

# IMPORTANT: Generate a strong secret for production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production

# Access token expiration (default: 24h)
JWT_EXPIRATION=24h

# Refresh token duration (default: 30 days)
# Users can stay logged in without re-entering credentials for this duration
JWT_REFRESH_DURATION=720h

# JWT issuer claim (default: actalog)
JWT_ISSUER=actalog

###############################################################################
# CORS CONFIGURATION
###############################################################################

# Comma-separated list of allowed origins
# In development, include both backend and frontend dev server URLs
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

###############################################################################
# REGISTRATION & EMAIL VERIFICATION
###############################################################################

# Allow new user registration after first user (admin)
# Set to false to close registration (invite-only mode)
# First user is always allowed and becomes admin automatically
ALLOW_REGISTRATION=true

# Require email verification for new users
# When true, users must verify their email before full access
# Requires EMAIL_ENABLED=true to send verification emails
REQUIRE_EMAIL_VERIFICATION=false

###############################################################################
# EMAIL / SMTP CONFIGURATION
###############################################################################

# Enable email sending (for password reset, email verification, notifications)
# Leave false if you don't need email features
EMAIL_ENABLED=false

# SMTP server settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password

# From address and name for outgoing emails
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=ActaLog

# --- Gmail SMTP Example ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password  # Use app-specific password, not your Gmail password
# EMAIL_FROM=your-email@gmail.com

# --- SMTP2GO Example ---
# SMTP_HOST=mail.smtp2go.com
# SMTP_PORT=2525
# SMTP_USER=your-smtp2go-user
# SMTP_PASSWORD=your-smtp2go-password

# --- SSL/TLS on port 465 ---
# SMTP_PORT=465
# Ensure your SMTP provider supports SSL on port 465

###############################################################################
# SECURITY CONFIGURATION
###############################################################################

# Maximum failed login attempts before account lockout (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration after max failed attempts (default: 15m)
ACCOUNT_LOCKOUT_DURATION=15m

# Password strength requirements (for future use)
# Minimum password length (default: 8)
MIN_PASSWORD_LENGTH=8

# Require specific character types (default: false for all)
REQUIRE_PASSWORD_UPPERCASE=false
REQUIRE_PASSWORD_LOWERCASE=false
REQUIRE_PASSWORD_NUMBER=false
REQUIRE_PASSWORD_SPECIAL=false

###############################################################################
# CLASS SCHEDULING (Phase 4 Feature)
###############################################################################

# Enable the class scheduling feature
# When enabled, the center nav button shows schedule instead of quick-log
# and scheduling-related admin features become available
SCHEDULER_ENABLED=false

# How often the session materializer runs (default: 6h)
# The materializer creates individual sessions from recurring templates
SCHEDULER_INTERVAL=6h

# Number of days ahead to materialize sessions (default: 14)
# Sessions are pre-created this many days in advance
SCHEDULER_DAYS_AHEAD=14

# Run session materialization immediately on startup (default: true)
# Set to false if you want to wait for the first scheduled interval
SCHEDULER_RUN_ON_STARTUP=true

###############################################################################
# FILE UPLOADS
###############################################################################

# Maximum upload size in bytes (default: 5MB)
MAX_UPLOAD_SIZE=5242880

# Directory for uploaded files (avatars, etc.)
UPLOAD_DIR=./uploads

###############################################################################
# RATE LIMITING
###############################################################################

# Enable rate limiting to prevent abuse
RATE_LIMIT_ENABLED=true

# Maximum requests per window
RATE_LIMIT_REQUESTS=100

# Time window for rate limit (Go duration format)
RATE_LIMIT_WINDOW=1m

###############################################################################
# OPENTELEMETRY (Optional - for observability)
###############################################################################

# OpenTelemetry endpoint for exporting traces and metrics
# OpenTelemetry is an observability framework for cloud-native software
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=actalog
OTEL_TRACES_ENABLED=false
OTEL_METRICS_ENABLED=false

###############################################################################
# DEMO MODE (Planned - Not Yet Implemented)
###############################################################################
# Demo mode allows running ActaLog as a public demonstration environment.
# When enabled, the system provides pre-configured demo users and restricts
# certain features to prevent abuse.
#
# Demo mode features:
# - Pre-configured demo users with fixed credentials (reset on restart)
# - Registration disabled (new users cannot sign up)
# - Email sending disabled (no actual emails sent)
# - Password changes disabled for demo users
# - Data resets periodically or on container restart (optional)
#
# Use case: Public demos, trade shows, evaluation environments
#
# ============================================================================
# IMPLEMENTATION STATUS:
# ============================================================================
# [IMPLEMENTED] ALLOW_REGISTRATION=false - Prevents new user signups
# [IMPLEMENTED] EMAIL_ENABLED=false - Disables all email sending
#
# [NOT YET IMPLEMENTED] All settings below are PLANNED but not yet built.
# They are documented here for future implementation.
# ============================================================================

# [NOT YET IMPLEMENTED] Enable demo mode
# DEMO_MODE=false

# [NOT YET IMPLEMENTED] Demo user credentials
# Format: email:password:name:role (comma-separated for multiple users)
# DEMO_USERS=demo@example.com:demo123:Demo User:user,admin@example.com:admin123:Demo Admin:admin

# [NOT YET IMPLEMENTED] Reset demo data on startup
# DEMO_RESET_ON_STARTUP=true

# [NOT YET IMPLEMENTED] Demo data seed file
# DEMO_SEED_FILE=./demo/seed_data.sql

# [NOT YET IMPLEMENTED] Demo session timeout
# DEMO_SESSION_TIMEOUT=1h

# [NOT YET IMPLEMENTED] Demo rate limiting (stricter than normal)
# DEMO_RATE_LIMIT_REQUESTS=30
# DEMO_RATE_LIMIT_WINDOW=1m

# [NOT YET IMPLEMENTED] Demo mode banner message
# DEMO_BANNER_MESSAGE=This is a demo environment. Data may be reset periodically.

# [NOT YET IMPLEMENTED] Disable features in demo mode
# Available: password_change, email_change, account_delete, data_export, admin_functions
# DEMO_DISABLED_FEATURES=password_change,email_change,account_delete

###############################################################################
# Current Workaround for Demo Setup:
# 1. Set ALLOW_REGISTRATION=false
# 2. Set EMAIL_ENABLED=false
# 3. Manually create demo users via first-user-admin flow or SQL
# 4. Share demo credentials with users
###############################################################################

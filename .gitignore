# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Build output
bin/
dist/
build/
.cache/

# Environment variables and credentials
.env
.env.local
.env.*.local
*.pem
!*example*.pem
!web/certs/localhost*.pem
*.key
!*example*.key
!web/certs/localhost*.key
**/secrets/
credentials.json
service-account*.json

# Database files
*.db
*.sqlite
*.sqlite3

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Claude Code local settings (may contain tokens/credentials)
.claude/settings.local.json
**/settings.local.json

# Logs
*.log
logs/

# Uploads and temporary files
uploads/
tmp/
temp/
# All files found in design/At sunset time/
design/At sunset time/*


# Frontend
node_modules/
.npm
.yarn
.pnpm-debug.log
web/dist/
web/dev-dist/
web/.nuxt/
web/.output/
web/.cache/

# OS files
Thumbs.db

# Backup files
*.bak
*.backup
backups/*

# Test cache
.cache/
.pytest_cache/
__pycache__/

# Coverage
coverage/
.nyc_output/

# Docker
docker-compose.override.yml
logs/

Caddyfile
*.pid

# Local screenshots and browser-automation artifacts (root only — keeps docs/ and screenshots/ tracked)
/*.png
.playwright-mcp/

# Git worktrees for isolated feature/fix development
.worktrees/
